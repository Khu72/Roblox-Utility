<Window x:Class="RobloxUtility.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:RobloxUtility.Models"
        xmlns:ui="clr-namespace:RobloxUtility.Controls"
        Title="Roblox Utility"
        Icon="{DynamicResource AppLogo}"
        Height="780" Width="940"
        MinWidth="820" MinHeight="700"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI, Segoe UI Variable Display"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseDown="Window_PreviewMouseDown">
  <Window.Resources>
    <BitmapImage x:Key="AppLogo"
                 UriSource="pack://application:,,,/Assets/brand.png"
                 DecodePixelWidth="128" CacheOption="OnLoad" />
  </Window.Resources>
  <Grid Margin="20,16,20,20" MinHeight="500">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="520" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,14" LastChildFill="True">
      <Image DockPanel.Dock="Left" Source="{StaticResource AppLogo}" Width="32" Height="32" Stretch="Uniform"
             VerticalAlignment="Top" Margin="0,4,12,0" />
      <StackPanel>
        <TextBlock Text="Roblox Utility" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
      </StackPanel>
    </DockPanel>

    <TabControl x:Name="RootTabs" Grid.Row="1" VerticalAlignment="Stretch" MinHeight="520">
      <!-- Multi-instance -->
      <TabItem Header="Multi-Instance">
        <Grid Margin="0,4,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="80" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="Multi-Instance" Style="{StaticResource H1}" />
          <TextBlock Grid.Row="1" Margin="0,10,0,0" Style="{StaticResource Body}"
                     Text="Roblox keeps a session-scoped named object (e.g. \Sessions\&lt;n&gt;\BaseNamedObjects\ROBLOX_singletonEvent) so only one client is allowed. This app finds that handle in running Roblox and closes it so you can open more than one. Run as Administrator if you get &quot;Access denied&quot; or handle-table errors. When you close a Roblox window, leftover tray processes are ended automatically." />
          <StackPanel Grid.Row="2" Margin="0,18,0,0" Orientation="Horizontal">
            <Button x:Name="EnableMultiInstanceButton" Style="{StaticResource PrimaryButton}" MinWidth="260"
                    Click="EnableMultiInstance_Click" Content="Enable multi-instance (all Roblox)" />
            <Button x:Name="ForceQuitRobloxButton" Margin="12,0,0,0" MinWidth="200"
                    Click="ForceQuitRoblox_Click" Content="Force quit all Roblox" />
          </StackPanel>
          <Border Grid.Row="3" Margin="0,16,0,0" VerticalAlignment="Stretch" Background="{StaticResource InputBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12">
            <TextBlock x:Name="MultiInstanceStatus" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="13" LineHeight="20" VerticalAlignment="Top" />
          </Border>
        </Grid>
      </TabItem>

      <!-- Accounts: star rows, no scroll -->
      <TabItem Header="Accounts">
        <Grid Margin="0,4,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.32*" MinWidth="200" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" MinWidth="320" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="{StaticResource InputBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10">
            <DockPanel LastChildFill="True">
              <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Saved accounts" Style="{StaticResource H2}" VerticalAlignment="Center" />
                <Button Grid.Column="1" x:Name="RefreshAccountsPresenceButton" Click="RefreshAccountsPresence_Click"
                        Content="Refresh" Padding="12,6" MinHeight="28" VerticalAlignment="Center"
                        ToolTip="Re-check online / in-game status using each account's saved cookie" />
              </Grid>
              <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="AddAccountButton" Click="AddAccount_Click" HorizontalAlignment="Stretch" MinHeight="32"
                        Content="Add" ToolTip="Finish naming and saving the current account before adding another (only one new row at a time)" />
                <Button Grid.Column="2" x:Name="DeleteAccountButton" Click="DeleteAccount_Click" HorizontalAlignment="Stretch" MinHeight="32"
                        Content="Remove" />
              </Grid>
              <ListBox x:Name="AccountsList" Style="{StaticResource SavedLeftList}" SelectionChanged="AccountsList_SelectionChanged"
                       ui:ListReorder.IsEnabled="True"
                       ToolTip="Drag a row to swap order — the card follows your pointer and other rows spring into place (Esc cancels)">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="{x:Type models:AccountRecord}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="{Binding ListLabel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <Grid Grid.Column="1" Width="20" Height="18" Margin="8,0,0,0">
                        <Ellipse x:Name="OnlineDot" Width="10" Height="10" Fill="{StaticResource Accent}" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" />
                        <Ellipse x:Name="InGameDot" Width="10" Height="10" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" />
                        <Ellipse x:Name="OfflineDot" Width="10" Height="10" Fill="#FF6B6E80" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" />
                        <TextBlock x:Name="InvalidGlyph" FontFamily="Segoe MDL2 Assets" Text="&#xE783;" FontSize="14"
                                   Foreground="#FFE85D5D" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"
                                   ToolTip="Saved cookie is invalid or expired — paste a fresh .ROBLOSECURITY and Save." />
                      </Grid>
                    </Grid>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding PresenceKind}" Value="{x:Static models:AccountPresenceKind.Online}">
                        <Setter TargetName="OnlineDot" Property="UIElement.Visibility" Value="Visible" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding PresenceKind}" Value="{x:Static models:AccountPresenceKind.InStudio}">
                        <Setter TargetName="OnlineDot" Property="UIElement.Visibility" Value="Visible" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding PresenceKind}" Value="{x:Static models:AccountPresenceKind.InGame}">
                        <Setter TargetName="InGameDot" Property="UIElement.Visibility" Value="Visible" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding PresenceKind}" Value="{x:Static models:AccountPresenceKind.Offline}">
                        <Setter TargetName="OfflineDot" Property="UIElement.Visibility" Value="Visible" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding PresenceKind}" Value="{x:Static models:AccountPresenceKind.InvalidCookie}">
                        <Setter TargetName="InvalidGlyph" Property="UIElement.Visibility" Value="Visible" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Border>

          <Grid x:Name="AccountDetailPanel" Grid.Column="2" IsEnabled="False">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" MinHeight="56" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Account details" Style="{StaticResource H1}" />
            <TextBlock Grid.Row="1" Margin="0,12,0,4" Style="{StaticResource Caption}" Text="Display name" />
            <TextBox Grid.Row="2" x:Name="AccName" />
            <TextBlock Grid.Row="3" Margin="0,10,0,4" Style="{StaticResource Caption}" Text="Experience" />
            <ComboBox Grid.Row="4" x:Name="AccExperienceCombo" SelectionChanged="AccExperienceCombo_SelectionChanged" />
            <TextBlock Grid.Row="5" Margin="0,10,0,4" Style="{StaticResource Caption}" Text="Place ID (used when &quot;Custom&quot; is selected above)" />
            <TextBox Grid.Row="6" x:Name="AccPlaceId" />
            <TextBlock Grid.Row="7" Margin="0,10,0,4" Style="{StaticResource Caption}" VerticalAlignment="Top" TextWrapping="Wrap"
                       Text=".ROBLOSECURITY (browser → DevTools → Application → Cookies). Like a password — never share." />
            <PasswordBox Grid.Row="8" x:Name="AccCookie" MinHeight="40" VerticalAlignment="Stretch" VerticalContentAlignment="Center" />
            <TextBlock Grid.Row="9" x:Name="AccCookieStatus" Foreground="{StaticResource SuccessBrush}" Margin="0,6,0,0" FontSize="12.5" TextWrapping="Wrap" />
            <Grid Grid.Row="10" Margin="0,12,0,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="48" />
              </Grid.RowDefinitions>
              <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Button x:Name="SaveAccountButton" Click="SaveAccount_Click" MinWidth="104" Content="Save" />
                <Button x:Name="LaunchAccountButton" Style="{StaticResource PrimaryButton}" Click="LaunchAccount_Click" MinWidth="200" Margin="10,0,0,0" Content="Join selected experience" />
                <Button x:Name="ClientOnlyButton" Click="ClientOnly_Click" MinWidth="160" Margin="10,0,0,0" Content="Start client only" />
              </StackPanel>
              <Border Grid.Row="1" Margin="0,10,0,0" Background="{StaticResource InputBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" VerticalAlignment="Stretch">
                <TextBlock x:Name="AccountLaunchStatus" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="13" LineHeight="20" VerticalAlignment="Top" />
              </Border>
            </Grid>
          </Grid>
        </Grid>
      </TabItem>

      <!-- Places -->
      <TabItem Header="Places">
        <Grid Margin="0,4,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.32*" MinWidth="200" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" MinWidth="320" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="{StaticResource InputBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10">
            <DockPanel LastChildFill="True">
              <TextBlock DockPanel.Dock="Top" Text="Saved places" Style="{StaticResource H2}" Margin="0,0,0,8" />
              <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="AddPlaceButton" Click="AddPlace_Click" HorizontalAlignment="Stretch" MinHeight="32"
                        Content="Add" ToolTip="Set a name and a valid place ID, save, then add more (one empty row at a time)" />
                <Button Grid.Column="2" x:Name="DeletePlaceButton" Click="DeletePlace_Click" HorizontalAlignment="Stretch" MinHeight="32"
                        Content="Remove" />
              </Grid>
              <ListBox x:Name="PlacesList" Style="{StaticResource SavedLeftList}" SelectionChanged="PlacesList_SelectionChanged"
                       ui:ListReorder.IsEnabled="True" DisplayMemberPath="ListLabel"
                       ToolTip="Drag a row to swap order — the card follows your pointer and other rows spring into place (Esc cancels)" />
            </DockPanel>
          </Border>
          <Grid Grid.Column="2" x:Name="PlaceDetailPanel" IsEnabled="False">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" MinHeight="120" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Place / experience" Style="{StaticResource H1}" />
            <TextBlock Grid.Row="1" Margin="0,12,0,4" Style="{StaticResource Caption}" Text="Display name" />
            <TextBox Grid.Row="2" x:Name="PlaceNameBox" />
            <TextBlock Grid.Row="3" Margin="0,10,0,4" Style="{StaticResource Caption}" Text="Place ID (Roblox universe ID)" />
            <TextBox Grid.Row="4" x:Name="PlaceIdBox" />
            <Button Grid.Row="5" x:Name="SavePlaceButton" Click="SavePlace_Click" HorizontalAlignment="Left" MinWidth="100" Margin="0,14,0,0" Content="Save place" />
            <Border Grid.Row="6" Margin="0,22,0,0" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True" SnapsToDevicePixels="True" Padding="14,12">
              <StackPanel>
                <TextBlock Text="Launch from here" Style="{StaticResource H2}" Margin="0,0,0,10" />
                <TextBlock Style="{StaticResource Caption}" Text="Account" Margin="0,0,0,4" />
                <ComboBox x:Name="PlacesTabAccountCombo" Margin="0,0,0,10" />
                <TextBlock Style="{StaticResource Caption}" Text="Experience" Margin="0,0,0,4" />
                <ComboBox x:Name="PlacesTabPlaceCombo" Margin="0,0,0,12" SelectionChanged="PlacesTabPlaceCombo_SelectionChanged" />
                <Button x:Name="PlacesTabLaunchButton" Style="{StaticResource PrimaryButton}" Click="PlacesTabLaunch_Click" HorizontalAlignment="Left" Content="Join as selected account" />
                <TextBlock x:Name="PlacesTabStatus" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="13" />
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
      </TabItem>

      <!-- Online friends across accounts -->
      <TabItem Header="Online Friends">
        <Grid Margin="0,4,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="200" />
          </Grid.RowDefinitions>
          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Online friends" Style="{StaticResource H1}" VerticalAlignment="Center" />
            <Button Grid.Column="1" x:Name="RefreshOnlineFriendsButton" Click="RefreshOnlineFriends_Click"
                    Content="Refresh" Padding="12,6" MinHeight="28" VerticalAlignment="Center"
                    ToolTip="Load friends who are online or in a game from every saved account that has a cookie" />
          </Grid>
          <TextBlock Grid.Row="1" x:Name="OnlineFriendsStatus" Margin="0,10,0,12" Style="{StaticResource Body}"
                     Text="Only friends who are online or in a game appear here. Each account needs a saved .ROBLOSECURITY cookie." />
          <Border Grid.Row="2" Background="{StaticResource InputBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8">
            <ListBox x:Name="OnlineFriendsList" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="Margin" Value="2,4,2,4" />
                  <Setter Property="Background" Value="#FF12141A" />
                  <Setter Property="BorderBrush" Value="#FF2E2E3A" />
                  <Setter Property="BorderThickness" Value="1" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="12,10"
                                SnapsToDevicePixels="True">
                          <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FF1A1D28" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderHoverBrush}" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type models:OnlineFriendRow}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="52" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#FF1E1E28" ClipToBounds="True">
                      <Image Source="{Binding Avatar}" Stretch="UniformToFill" Width="44" Height="44" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding TitleText}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding GameText}" Margin="0,3,0,0" FontSize="12.5" Foreground="{StaticResource Accent}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Margin="0,5,0,0" FontSize="12" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap">
                        <Run Text="On accounts: " />
                        <Run Text="{Binding OnAccountsText}" />
                      </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                      <Button Content="Copy username" Padding="10,6" MinHeight="28" Margin="0,0,0,6"
                              Click="CopyFriendUsername_Click"
                              ToolTip="Copy Roblox username to clipboard" />
                      <Button Content="Copy user ID" Padding="10,6" MinHeight="28"
                              Click="CopyFriendUserId_Click"
                              ToolTip="Copy numeric user ID to clipboard" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
        </Grid>
      </TabItem>

      <!-- Auto Clicker -->
      <TabItem Header="Auto Clicker">
        <Grid Margin="0,4,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="420" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="1.1*" MinWidth="280" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Top" MinWidth="200">
            <TextBlock Text="Auto Clicker" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource Body}" Margin="0,12,0,0"
                       Text="Click the 3D game view so Roblox is the foreground window (not this app, and not only the chat box). Hold the left mouse button in-game to repeat clicks at the rate on the right. Overlays like Discord or Xbox Game Bar on top can block focus—click the game first. Use responsibly." />
            <Border Style="{StaticResource AutoClickEnablePill}" Margin="0,18,0,0" Padding="14,12" VerticalAlignment="Top" HorizontalAlignment="Left">
              <CheckBox x:Name="AutoClickEnabled" Content="Enable auto clicker" Style="{StaticResource EmphasisCheckBox}"
                        Checked="AutoClickSetting_Changed" Unchecked="AutoClickSetting_Changed" />
            </Border>
            <Border Style="{StaticResource AutoClickEnablePill}" Margin="0,10,0,0" Padding="14,12" VerticalAlignment="Top" HorizontalAlignment="Left">
              <CheckBox x:Name="AutoHotkeyEnabled" Content="Enable keybind (toggle on/off)" Style="{StaticResource EmphasisCheckBox}"
                        Checked="KeybindSetting_Changed" Unchecked="KeybindSetting_Changed" />
            </Border>
            <Border Margin="0,10,0,0" Background="{StaticResource InputBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="10" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource Caption}" Text="Keybind" />
                <Button x:Name="AutoHotkeyButton" Grid.Column="2" MinWidth="120" MaxWidth="170" MinHeight="30"
                        HorizontalAlignment="Left" VerticalAlignment="Center" Content="F6"
                        Click="AutoHotkeyButton_Click"
                        ToolTip="Click, then press a keyboard key or middle/side mouse button." />
              </Grid>
            </Border>
            <Border Style="{StaticResource AutoClickEnablePill}" Margin="0,10,0,0" Padding="14,12" VerticalAlignment="Top" HorizontalAlignment="Left">
              <CheckBox x:Name="AutoHotkeyNotifyEnabled" Content="Notify when keybind toggles auto clicker" Style="{StaticResource EmphasisCheckBox}"
                        Checked="KeybindSetting_Changed" Unchecked="KeybindSetting_Changed" />
            </Border>
            <Border Margin="0,16,0,0" Background="{StaticResource InputBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" ClipToBounds="True">
              <TextBlock x:Name="AutoStatus" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="13" LineHeight="20" />
            </Border>
          </StackPanel>
          <UniformGrid Grid.Column="2" Columns="1" Rows="3" VerticalAlignment="Top" MinHeight="300">
            <Border Margin="0,0,0,10" Background="{StaticResource InputBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,14">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Clicks per second" Foreground="{StaticResource TextMuted}" FontSize="12" />
                <TextBlock Grid.Row="1" x:Name="CpsBigValue" Text="8" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,4,0,8" />
                <Slider Grid.Row="2" x:Name="CpsSlider" Style="{StaticResource FlatSlider}" Minimum="1" Maximum="100" Value="8" IsSnapToTickEnabled="True" TickFrequency="1" />
              </Grid>
            </Border>
            <Border Margin="0,0,0,10" Background="{StaticResource InputBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,14">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Initial delay (ms)" Foreground="{StaticResource TextMuted}" FontSize="12" />
                <TextBlock Grid.Row="1" x:Name="InitialDelayBigValue" Text="0" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,4,0,8" />
                <Slider Grid.Row="2" x:Name="InitialDelaySlider" Style="{StaticResource FlatSlider}" Minimum="0" Maximum="1000" IsSnapToTickEnabled="True" Value="0" TickFrequency="5" />
              </Grid>
            </Border>
            <Border Background="{StaticResource InputBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,14">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Extra delay per click (ms)" Foreground="{StaticResource TextMuted}" FontSize="12" />
                <TextBlock Grid.Row="1" x:Name="ExtraDelayBigValue" Text="0" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,4,0,8" />
                <Slider Grid.Row="2" x:Name="ExtraDelaySlider" Style="{StaticResource FlatSlider}" Minimum="0" Maximum="500" IsSnapToTickEnabled="True" TickFrequency="1" Value="0" />
              </Grid>
            </Border>
            </UniformGrid>
        </Grid>
      </TabItem>

      <TabItem Header="Console">
        <Grid Margin="0,4,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="Application Logs" Style="{StaticResource H1}" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" x:Name="ConsoleClearButton" Content="Clear" MinWidth="72" Click="ConsoleClear_Click" VerticalAlignment="Center" />
          </DockPanel>
          <Border Grid.Row="1" Margin="0,0,0,10" Background="{StaticResource InputBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource Caption}" Text="Open links in" />
              <ComboBox Grid.Column="2"
                        x:Name="ConsoleBrowserCombo"
                        MinHeight="30"
                        DisplayMemberPath="Label"
                        SelectedValuePath="Value"
                        SelectionChanged="ConsoleBrowserSetting_Changed" />
              <CheckBox Grid.Column="4"
                        x:Name="ConsolePrivateBrowsingCheck"
                        Content="Open in private / incognito window"
                        VerticalAlignment="Center"
                        Checked="ConsoleBrowserSetting_Changed"
                        Unchecked="ConsoleBrowserSetting_Changed" />
            </Grid>
          </Border>
          <Border Grid.Row="2" Background="#FF0D1117" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8">
            <RichTextBox x:Name="AppConsoleBox"
                         IsReadOnly="True"
                         IsDocumentEnabled="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         SizeChanged="AppConsoleBox_SizeChanged"
                         FontFamily="Cascadia Mono, Consolas"
                         FontSize="13.5"
                         Foreground="#FFF0F6FC"
                         Background="Transparent"
                         BorderThickness="0"
                         CaretBrush="#FFF0F6FC"
                         SelectionBrush="#FF2F81F7"
                         SelectionOpacity="0.35"
                         TextOptions.TextFormattingMode="Display">
              <FlowDocument PagePadding="0" TextAlignment="Left" />
            </RichTextBox>
          </Border>
          <Border Grid.Row="3" Margin="0,8,0,0" Background="#FF0D1117" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8,6">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0"
                         Text=">"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center"
                         FontFamily="Cascadia Mono, Consolas"
                         FontSize="13.5"
                         Foreground="#FF8B949E" />
              <TextBox Grid.Column="1"
                       x:Name="ConsoleInputBox"
                       KeyDown="ConsoleInput_KeyDown"
                       TextWrapping="NoWrap"
                       FontFamily="Cascadia Mono, Consolas"
                       FontSize="13.5"
                       Foreground="#FFF0F6FC"
                       Background="Transparent"
                       BorderThickness="0"
                       CaretBrush="#FFF0F6FC"
                       SelectionBrush="#FF2F81F7"
                       SelectionOpacity="0.35"
                       TextOptions.TextFormattingMode="Display">
                <TextBox.ToolTip>
                  <ToolTip Content="Type a command and press Enter (e.g. /getuser Roblox or /getuser 1562160156)" />
                </TextBox.ToolTip>
              </TextBox>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
