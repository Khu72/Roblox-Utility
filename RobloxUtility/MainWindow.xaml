<Window x:Class="RobloxUtility.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Roblox Utility"
        Icon="{DynamicResource AppLogo}"
        Height="780" Width="940"
        MinWidth="820" MinHeight="700"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI, Segoe UI Variable Display"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseDown="Window_PreviewMouseDown">
  <Window.Resources>
    <BitmapImage x:Key="AppLogo"
                 UriSource="pack://application:,,,/Assets/brand.png"
                 DecodePixelWidth="128" CacheOption="OnLoad" />
  </Window.Resources>
  <Grid Margin="20,16,20,20" MinHeight="500">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="520" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,14" LastChildFill="True">
      <Image DockPanel.Dock="Left" Source="{StaticResource AppLogo}" Width="32" Height="32" Stretch="Uniform"
             VerticalAlignment="Top" Margin="0,4,12,0" />
      <StackPanel>
        <TextBlock Text="Roblox Utility" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
      </StackPanel>
    </DockPanel>

    <TabControl x:Name="RootTabs" Grid.Row="1" VerticalAlignment="Stretch" MinHeight="520">
      <!-- Multi-instance -->
      <TabItem Header="Multi-Instance">
        <Grid Margin="0,4,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="80" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="Multi-Instance" Style="{StaticResource H1}" />
          <TextBlock Grid.Row="1" Margin="0,10,0,0" Style="{StaticResource Body}"
                     Text="Roblox keeps a named kernel object (often shown as \BaseNamedObjects\ROBLOX_singletonEvent) so only one client is allowed. This app finds that handle in running RobloxPlayerBeta.exe and closes it so you can open more than one. Run as Administrator if you get &quot;Access denied&quot;." />
          <Button Grid.Row="2" x:Name="EnableMultiInstanceButton" Style="{StaticResource PrimaryButton}" Margin="0,18,0,0" HorizontalAlignment="Left" MinWidth="260"
                  Click="EnableMultiInstance_Click" Content="Enable multi-instance (all Roblox)" />
          <Border Grid.Row="3" Margin="0,16,0,0" VerticalAlignment="Stretch" Background="{StaticResource InputBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12">
            <TextBlock x:Name="MultiInstanceStatus" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="13" LineHeight="20" VerticalAlignment="Top" />
          </Border>
        </Grid>
      </TabItem>

      <!-- Accounts: star rows, no scroll -->
      <TabItem Header="Accounts">
        <Grid Margin="0,4,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.32*" MinWidth="200" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" MinWidth="320" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="{StaticResource InputBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10">
            <DockPanel LastChildFill="True">
              <TextBlock DockPanel.Dock="Top" Text="Saved accounts" Style="{StaticResource H2}" Margin="0,0,0,8" />
              <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="AddAccountButton" Click="AddAccount_Click" HorizontalAlignment="Stretch" MinHeight="32"
                        Content="Add" ToolTip="Finish naming and saving the current account before adding another (only one new row at a time)" />
                <Button Grid.Column="2" x:Name="DeleteAccountButton" Click="DeleteAccount_Click" HorizontalAlignment="Stretch" MinHeight="32"
                        Content="Remove" />
              </Grid>
              <ListBox x:Name="AccountsList" Style="{StaticResource SavedLeftList}" SelectionChanged="AccountsList_SelectionChanged" DisplayMemberPath="ListLabel" />
            </DockPanel>
          </Border>

          <Grid x:Name="AccountDetailPanel" Grid.Column="2" IsEnabled="False">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" MinHeight="56" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Account details" Style="{StaticResource H1}" />
            <TextBlock Grid.Row="1" Margin="0,12,0,4" Style="{StaticResource Caption}" Text="Display name" />
            <TextBox Grid.Row="2" x:Name="AccName" />
            <TextBlock Grid.Row="3" Margin="0,10,0,4" Style="{StaticResource Caption}" Text="Experience" />
            <ComboBox Grid.Row="4" x:Name="AccExperienceCombo" SelectionChanged="AccExperienceCombo_SelectionChanged" />
            <TextBlock Grid.Row="5" Margin="0,10,0,4" Style="{StaticResource Caption}" Text="Place ID (used when &quot;Custom&quot; is selected above)" />
            <TextBox Grid.Row="6" x:Name="AccPlaceId" />
            <TextBlock Grid.Row="7" Margin="0,10,0,4" Style="{StaticResource Caption}" VerticalAlignment="Top" TextWrapping="Wrap"
                       Text=".ROBLOSECURITY (browser → DevTools → Application → Cookies). Like a password — never share." />
            <PasswordBox Grid.Row="8" x:Name="AccCookie" MinHeight="40" VerticalAlignment="Stretch" VerticalContentAlignment="Center" />
            <TextBlock Grid.Row="9" x:Name="AccCookieStatus" Foreground="{StaticResource SuccessBrush}" Margin="0,6,0,0" FontSize="12.5" TextWrapping="Wrap" />
            <Grid Grid.Row="10" Margin="0,12,0,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="48" />
              </Grid.RowDefinitions>
              <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Button x:Name="SaveAccountButton" Click="SaveAccount_Click" MinWidth="104" Content="Save" />
                <Button x:Name="LaunchAccountButton" Style="{StaticResource PrimaryButton}" Click="LaunchAccount_Click" MinWidth="200" Margin="10,0,0,0" Content="Join selected experience" />
                <Button x:Name="ClientOnlyButton" Click="ClientOnly_Click" MinWidth="160" Margin="10,0,0,0" Content="Start client only" />
              </StackPanel>
              <Border Grid.Row="1" Margin="0,10,0,0" Background="{StaticResource InputBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" VerticalAlignment="Stretch">
                <TextBlock x:Name="AccountLaunchStatus" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="13" LineHeight="20" VerticalAlignment="Top" />
              </Border>
            </Grid>
          </Grid>
        </Grid>
      </TabItem>

      <!-- Places -->
      <TabItem Header="Places">
        <Grid Margin="0,4,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.32*" MinWidth="200" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" MinWidth="320" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="{StaticResource InputBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10">
            <DockPanel LastChildFill="True">
              <TextBlock DockPanel.Dock="Top" Text="Saved places" Style="{StaticResource H2}" Margin="0,0,0,8" />
              <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="AddPlaceButton" Click="AddPlace_Click" HorizontalAlignment="Stretch" MinHeight="32"
                        Content="Add" ToolTip="Set a name and a valid place ID, save, then add more (one empty row at a time)" />
                <Button Grid.Column="2" x:Name="DeletePlaceButton" Click="DeletePlace_Click" HorizontalAlignment="Stretch" MinHeight="32"
                        Content="Remove" />
              </Grid>
              <ListBox x:Name="PlacesList" Style="{StaticResource SavedLeftList}" SelectionChanged="PlacesList_SelectionChanged" DisplayMemberPath="ListLabel" />
            </DockPanel>
          </Border>
          <Grid Grid.Column="2" x:Name="PlaceDetailPanel" IsEnabled="False">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" MinHeight="120" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Place / experience" Style="{StaticResource H1}" />
            <TextBlock Grid.Row="1" Margin="0,12,0,4" Style="{StaticResource Caption}" Text="Display name" />
            <TextBox Grid.Row="2" x:Name="PlaceNameBox" />
            <TextBlock Grid.Row="3" Margin="0,10,0,4" Style="{StaticResource Caption}" Text="Place ID (Roblox universe ID)" />
            <TextBox Grid.Row="4" x:Name="PlaceIdBox" />
            <Button Grid.Row="5" x:Name="SavePlaceButton" Click="SavePlace_Click" HorizontalAlignment="Left" MinWidth="100" Margin="0,14,0,0" Content="Save place" />
            <Border Grid.Row="6" Margin="0,22,0,0" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True" SnapsToDevicePixels="True" Padding="14,12">
              <StackPanel>
                <TextBlock Text="Launch from here" Style="{StaticResource H2}" Margin="0,0,0,10" />
                <TextBlock Style="{StaticResource Caption}" Text="Account" Margin="0,0,0,4" />
                <ComboBox x:Name="PlacesTabAccountCombo" Margin="0,0,0,10" />
                <TextBlock Style="{StaticResource Caption}" Text="Experience" Margin="0,0,0,4" />
                <ComboBox x:Name="PlacesTabPlaceCombo" Margin="0,0,0,12" SelectionChanged="PlacesTabPlaceCombo_SelectionChanged" />
                <Button x:Name="PlacesTabLaunchButton" Style="{StaticResource PrimaryButton}" Click="PlacesTabLaunch_Click" HorizontalAlignment="Left" Content="Join as selected account" />
                <TextBlock x:Name="PlacesTabStatus" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="13" />
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
      </TabItem>

      <!-- Auto Clicker -->
      <TabItem Header="Auto Clicker">
        <Grid Margin="0,4,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="420" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="1.1*" MinWidth="280" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Top" MinWidth="200">
            <TextBlock Text="Auto Clicker" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource Body}" Margin="0,12,0,0"
                       Text="Click the 3D game view so Roblox is the foreground window (not this app, and not only the chat box). Hold the left mouse button in-game to repeat clicks at the rate on the right. Overlays like Discord or Xbox Game Bar on top can block focus—click the game first. Use responsibly." />
            <Border Style="{StaticResource AutoClickEnablePill}" Margin="0,18,0,0" Padding="14,12" VerticalAlignment="Top" HorizontalAlignment="Left">
              <CheckBox x:Name="AutoClickEnabled" Content="Enable auto clicker" Style="{StaticResource EmphasisCheckBox}"
                        Checked="AutoClickSetting_Changed" Unchecked="AutoClickSetting_Changed" />
            </Border>
            <Border Style="{StaticResource AutoClickEnablePill}" Margin="0,10,0,0" Padding="14,12" VerticalAlignment="Top" HorizontalAlignment="Left">
              <CheckBox x:Name="AutoHotkeyEnabled" Content="Enable keybind (toggle on/off)" Style="{StaticResource EmphasisCheckBox}"
                        Checked="KeybindSetting_Changed" Unchecked="KeybindSetting_Changed" />
            </Border>
            <Border Margin="0,10,0,0" Background="{StaticResource InputBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="10" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource Caption}" Text="Keybind" />
                <Button x:Name="AutoHotkeyButton" Grid.Column="2" MinWidth="120" MaxWidth="170" MinHeight="30"
                        HorizontalAlignment="Left" VerticalAlignment="Center" Content="F6"
                        Click="AutoHotkeyButton_Click"
                        ToolTip="Click, then press a keyboard key or middle/side mouse button." />
              </Grid>
            </Border>
            <Border Style="{StaticResource AutoClickEnablePill}" Margin="0,10,0,0" Padding="14,12" VerticalAlignment="Top" HorizontalAlignment="Left">
              <CheckBox x:Name="AutoHotkeyNotifyEnabled" Content="Notify when keybind toggles auto clicker" Style="{StaticResource EmphasisCheckBox}"
                        Checked="KeybindSetting_Changed" Unchecked="KeybindSetting_Changed" />
            </Border>
            <Border Margin="0,16,0,0" Background="{StaticResource InputBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" ClipToBounds="True">
              <TextBlock x:Name="AutoStatus" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="13" LineHeight="20" />
            </Border>
          </StackPanel>
          <UniformGrid Grid.Column="2" Columns="1" Rows="3" VerticalAlignment="Top" MinHeight="300">
            <Border Margin="0,0,0,10" Background="{StaticResource InputBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,14">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Clicks per second" Foreground="{StaticResource TextMuted}" FontSize="12" />
                <TextBlock Grid.Row="1" x:Name="CpsBigValue" Text="8" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,4,0,8" />
                <Slider Grid.Row="2" x:Name="CpsSlider" Style="{StaticResource FlatSlider}" Minimum="1" Maximum="40" Value="8" IsSnapToTickEnabled="True" TickFrequency="1" />
              </Grid>
            </Border>
            <Border Margin="0,0,0,10" Background="{StaticResource InputBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,14">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Initial delay (ms)" Foreground="{StaticResource TextMuted}" FontSize="12" />
                <TextBlock Grid.Row="1" x:Name="InitialDelayBigValue" Text="0" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,4,0,8" />
                <Slider Grid.Row="2" x:Name="InitialDelaySlider" Style="{StaticResource FlatSlider}" Minimum="0" Maximum="1000" IsSnapToTickEnabled="True" Value="0" TickFrequency="5" />
              </Grid>
            </Border>
            <Border Background="{StaticResource InputBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,14">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Extra delay per click (ms)" Foreground="{StaticResource TextMuted}" FontSize="12" />
                <TextBlock Grid.Row="1" x:Name="ExtraDelayBigValue" Text="0" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,4,0,8" />
                <Slider Grid.Row="2" x:Name="ExtraDelaySlider" Style="{StaticResource FlatSlider}" Minimum="0" Maximum="500" IsSnapToTickEnabled="True" TickFrequency="1" Value="0" />
              </Grid>
            </Border>
            </UniformGrid>
        </Grid>
      </TabItem>

      <TabItem Header="Console">
        <Grid Margin="0,4,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="Application Logs" Style="{StaticResource H1}" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" x:Name="ConsoleClearButton" Content="Clear" MinWidth="72" Click="ConsoleClear_Click" VerticalAlignment="Center" />
          </DockPanel>
          <Border Grid.Row="1" Background="#FF0D1117" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8">
            <TextBox x:Name="AppConsoleBox"
                     IsReadOnly="True"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Cascadia Mono, Consolas"
                     FontSize="13.5"
                     Foreground="#FFF0F6FC"
                     Background="Transparent"
                     BorderThickness="0"
                     CaretBrush="#FFF0F6FC"
                     SelectionBrush="#FF2F81F7"
                     SelectionOpacity="0.35"
                     AcceptsReturn="True"
                     TextOptions.TextFormattingMode="Display" />
          </Border>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
